{
  "$description": "Shared design tokens for web (Tailwind/shadcn CSS variables) and the native apps (generated Swift + Compose themes). Black & white, casual-professional. Colour only for functional state.",
  "color": {
    "light": {
      "background": "#FFFFFF",
      "foreground": "#0A0A0A",
      "surface": "#FAFAFA",
      "muted": "#F5F5F5",
      "mutedForeground": "#737373",
      "border": "#E5E5E5",
      "primary": "#0A0A0A",
      "primaryForeground": "#FFFFFF"
    },
    "dark": {
      "background": "#0A0A0A",
      "foreground": "#FAFAFA",
      "surface": "#141414",
      "muted": "#1F1F1F",
      "mutedForeground": "#A3A3A3",
      "border": "#262626",
      "primary": "#FAFAFA",
      "primaryForeground": "#0A0A0A"
    },
    "state": {
      "up": "#15803D",
      "down": "#B91C1C",
      "error": "#DC2626"
    }
  },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 20, "full": 9999 },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "font": {
    "family": "Geist",
    "mono": "Geist Mono",
    "numerals": "tabular-nums",
    "size": { "xs": 12, "sm": 14, "base": 16, "lg": 18, "xl": 20, "2xl": 24, "3xl": 30, "4xl": 36, "5xl": 48, "score": 56 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "icon": { "size": 24, "stroke": 1.75, "style": "outline, round caps and joins, currentColor" },
  "touchTarget": 44,
  "motion": { "fast": 150, "base": 200 }
}
